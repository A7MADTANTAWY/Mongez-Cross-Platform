# Python cache + virtualenvs
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local secrets and DBs (env is supplied at run time via docker-compose env_file)
backend/.env
*.sqlite3
*.sqlite3-journal

# Outputs — regenerated at image build time (collectstatic)
backend/media/
backend/staticfiles/

# VCS + tooling
.git/
.gitignore
.github/
.claude/
.codex
.idea/
.vscode/

# Docs (kept in source control, not needed in the image)
docs/
*.md
*.log

# Deployment configuration — not served by the backend image itself
deployment/

# Other applications — not needed in backend image (backend Dockerfile copies explicitly)
# frontend/ and mobile/ intentionally NOT excluded here so Railway Railpack
# can build them as separate services from the same monorepo.

# OS junk
.DS_Store
Thumbs.db
