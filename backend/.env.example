###############################################################################
# Mongez backend — environment variables
# Copy this file to `.env` and edit the values you need. The Docker stack
# loads `.env` automatically; the `runserver` flow falls back to safe
# defaults when a variable is missing.
###############################################################################

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_TIME_ZONE=UTC

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Pagination ───────────────────────────────────────────────────────────────
API_PAGE_SIZE=20

# ── Rate limiting (DRF throttles, format "<count>/<period>") ─────────────────
# period: second / minute / hour / day
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
THROTTLE_ORDER=20/hour
THROTTLE_RATING=30/hour

# ── Paymob (commission payments) ─────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=0
PAYMOB_HMAC_SECRET=
COMMISSION_AMOUNT=20

# ── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# Upload to Railway as a file, then set GOOGLE_APPLICATION_CREDENTIALS to its path.
FCM_PROJECT_ID=mongez-86fdf

# ── Google OAuth (Sign-In with Google) ───────────────────────────────────────
# Web Client ID from Google Cloud Console (NOT the Android Client ID).
GOOGLE_WEB_CLIENT_ID=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Defaults below match the local dev PostgreSQL described in WINDOWS.md.
# In Docker, override these so the web container reaches the `db` service
# (e.g. DB_HOST=db). In production, set real credentials via env.json.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mongez
DB_USER=mongez
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# When set, DATABASE_URL takes priority over all DB_* variables above and is
# used verbatim. Use this on Render (Render PostgreSQL provides it) and in
# any other production host. Example:
# DATABASE_URL=postgresql://USER:PASS@HOST:PORT/NAME

# ─────────────────────────────────────────────────────────────────────────────
# Render Production (optional on local)
# ─────────────────────────────────────────────────────────────────────────────
# Render injects RENDER=1 and RENDER_EXTERNAL_HOSTNAME automatically; the
# backend uses them to enable production hardening and to allow its own host.
# Everything below is optional locally and only needed on Render.
# DJANGO_ENV=production            # forces DEBUG=False + requires DJANGO_SECRET_KEY
# DJANGO_SECRET_KEY=               # REQUIRED on Render - generate a long random string
# DJANGO_ALLOWED_HOSTS=            # comma-separated extra hosts (Render hostname is auto-added)
# CORS_ALLOWED_ORIGINS=            # comma-separated origins to allow (Render origin is auto-added)
# CSRF_TRUSTED_ORIGINS=            # comma-separated trusted origins (Render origin is auto-added)
# DJANGO_TIME_ZONE=UTC
# --- Security / HTTPS (enable on Render) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# ─────────────────────────────────────────────────────────────────────────────
# Railway Production (optional on local)
# ─────────────────────────────────────────────────────────────────────────────
# Railway automatically injects DATABASE_URL, PORT, RAILWAY_PROJECT_ID,
# RAILWAY_SERVICE_NAME, RAILWAY_PUBLIC_DOMAIN (once a public domain is added)
# and other env vars. When RAILWAY_* variables are detected the backend
# defaults to production mode (DEBUG=False, DJANGO_SECRET_KEY required) unless
# DJANGO_ENV is explicitly overridden.
#
# Key variables to set in the Railway service dashboard:
#   DJANGO_SECRET_KEY              — generate a long random string
#   DJANGO_DEBUG=false             — (optional, already false by default on Railway)
#   FRONTEND_URL=https://...       — the Vercel/Render dashboard URL for CORS/CSRF
#   CLOUDINARY_CLOUD_NAME=...      — for media storage (Cloudinary)
#   CLOUDINARY_API_KEY=...
#   CLOUDINARY_API_SECRET=...
#
# On Railway, SECURE_PROXY_SSL_HEADER and SESSION/CSRF cookie-secure flags
# default to True (Railway terminates TLS at its edge proxy). DJANGO_SECURE_SSL_REDIRECT
# stays False by default because Railway handles HTTPS redirects itself.
# PORT=                            # injected by Railway — used by the start command
