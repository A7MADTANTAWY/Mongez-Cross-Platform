# Mongez mobile app — build-time configuration
#
# These values are injected at build/run time via --dart-define (Flutter).
# There is no runtime .env loader in the app; passing them via dart-define
# keeps them out of source control.
#
# Example usage:
#   flutter run --dart-define=API_BASE_URL=https://your-domain.com/api/ \
#               --dart-define=GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
#
# API_BASE_URL
#   Base URL of the Django backend API. Defaults to the local LAN IP
#   (see lib/core/constants/api_constants.dart) for physical-device dev.
#
# GOOGLE_CLIENT_ID
#   Google Web Client ID used for Sign-In with Google.
