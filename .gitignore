# ── Backend (Django) ────────────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/.env
backend/.venv/
backend/venv/
backend/staticfiles/
backend/media/
backend/srv_err.log
backend/srv_out.log

# SQLite is not used in production (PostgreSQL is) — historical files only.
*.sqlite3
*.sqlite3-journal
*.sqlite3.backup*

# ── Frontend (React) ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.firebase/
frontend/.vite/
frontend/.env

# ── Mobile (Flutter) ────────────────────────────────────────────────────────
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/app/build.gradle.kts?*~
mobile/android/build/
mobile/android/app/release-key.jks
mobile/android/key.properties
mobile/hs_err_pid*.log
mobile/flutter_log.txt
mobile/*.jks
mobile/.env

# ── Local environment files (templates *.env.example stay tracked) ───────────
.env
.env.*
!.env.example

# ── Deployment (generated output — rebuilt by deployment/scripts/build.*) ──
deployment/out/
deployment/scripts/.dashboard.pid
deployment/scripts/.dashboard.log

# ── Local tooling / IDE ─────────────────────────────────────────────────────
.vscode/*
.idea/
.codex
*.swp

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / temp ─────────────────────────────────────────────────────────────
*.log
hs_err_pid*.log
flutter_log.txt
